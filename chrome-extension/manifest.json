{
  "manifest_version": 3,
  "name": "AuthWin OTP Trigger",
  "version": "1.0",
  "description": "Automatically brings AuthWin to the foreground when a page asks for an OTP / verification code.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
